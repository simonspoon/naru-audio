<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.naru.audio</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN__</string>
    <string>serve</string>
    <string>--allow-remote</string>
    <string>--listen</string>
    <string>0.0.0.0:7870</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.naru-audio/serve.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.naru-audio/serve.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>RUST_LOG</key>
    <string>naru_audio=info</string>
  </dict>
</dict>
</plist>
